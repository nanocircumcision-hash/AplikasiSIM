# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# KONFIGURASI HOSTING DI CLOUD (RENDER, RAILWAY, NEON, SUPABASE)
# ==============================================================================
# Di Render Dashboard -> Web Service -> Environment -> Tambahkan Environment Variable:
# Key   : DATABASE_URL
# Value : [Salin Internal Database URL dari PostgreSQL Render, misal: postgresql://nano_clinic_user:pass@dpg-xxxxxx-a/nano_clinic]
# Key   : NODE_ENV
# Value : production
#
# DATABASE_URL=postgresql://user:password@hostname:5432/database_name

# ==============================================================================
# KONFIGURASI DATABASE POSTGRESQL LOKAL / OFFLINE (PGADMIN 4)
# ==============================================================================
# Gunakan salah satu opsi di bawah ini saat aplikasi diinstal di komputer lokal:
#
# Opsi 1 (Direkomendasikan - Parameter Terpisah):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nano_clinic

# Opsi 2 (Menggunakan Connection String tunggal):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nano_clinic
